PORT=3100
NODE_ENV=development

# Base de datos PostgreSQL (crea antes una base vacia con ese nombre)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=studentscope_mj
DB_USER=postgres
DB_PASSWORD=
# Alternativa: una sola cadena de conexion. Si la defines, tiene prioridad sobre DB_*.
# DATABASE_URL=postgres://usuario:clave@localhost:5432/studentscope_mj

# Secreto para firmar la sesion: minimo 32 caracteres, generado al azar
JWT_SECRET=

# Primer administrador: se crea al iniciar si todavia no existe ninguno
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Cargar 35 estudiantes de ejemplo al iniciar si la tabla esta vacia (true o false)
SEMBRAR_EJEMPLO=true

# Demo publica para el portafolio (true o false). Con true se crea la cuenta demo, los visitantes
# entran sin registrarse y TODOS los estudiantes se restauran a los de ejemplo cada cierto tiempo.
DEMO_HABILITADA=false
DEMO_REINICIO_MINUTOS=60
DEMO_MAX_ESTUDIANTES=100

# Servicio de riesgo de abandono (opcional). Si se deja vacio, GET /api/estudiantes/:id/riesgo responde 503.
# RIESGO_URL=http://riesgo:8000

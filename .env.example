PORT=3100
NODE_ENV=development

# Base de datos PostgreSQL (crea antes una base vacia con ese nombre)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=studentscope_mj
DB_USER=postgres
DB_PASSWORD=
# Alternativa: una sola cadena de conexion. Si la defines, tiene prioridad sobre DB_*.
# DATABASE_URL=postgres://usuario:clave@localhost:5432/studentscope_mj

# Secreto para firmar la sesion: minimo 32 caracteres, generado al azar
JWT_SECRET=

# Primer administrador: se crea al iniciar si todavia no existe ninguno
ADMIN_EMAIL=
ADMIN_PASSWORD=

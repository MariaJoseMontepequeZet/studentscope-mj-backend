{
  "name": "StudentScope MJ: aviso de inactivos",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 8
            }
          ]
        }
      },
      "id": "cada-dia",
      "name": "Cada día a las 8",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.STUDENTSCOPE_URL }}/api/auth/login",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ email: $env.STUDENTSCOPE_EMAIL, password: $env.STUDENTSCOPE_PASSWORD }) }}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true
            }
          }
        }
      },
      "id": "iniciar-sesion",
      "name": "Iniciar sesión",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "url": "={{ $env.STUDENTSCOPE_URL }}/api/estudiantes?estado=inactivo&limite=100",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Cookie",
              "value": "={{ $('Iniciar sesión').first().json.headers['set-cookie'][0].split(';')[0] }}"
            }
          ]
        },
        "options": {}
      },
      "id": "inactivos",
      "name": "Inactivos",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Quiénes dejaron el curso sin terminarlo, a partir de GET /api/estudiantes?estado=inactivo\nconst respuesta = $('Inactivos').first().json;\nconst sinTerminar = (respuesta.estudiantes || [])\n  .filter((e) => e.progreso < 100)\n  .sort((a, b) => a.progreso - b.progreso);\n\nconst lineas = sinTerminar.map(\n  (e) => '  - ' + e.nombre + ' ' + e.apellido + ' (' + e.email + '), ' + e.curso.nombre + ', progreso ' + e.progreso + '%'\n);\nconst mas = respuesta.total > (respuesta.estudiantes || []).length\n  ? ['', 'Hay más inactivos en la lista completa: se muestran los primeros ' + respuesta.estudiantes.length + '.']\n  : [];\n\nconst texto = [\n  'Estudiantes que dejaron el curso sin terminarlo: ' + sinTerminar.length,\n  '',\n  ...lineas,\n  ...mas\n].join('\\n');\n\nreturn [{ json: { cantidad: sinTerminar.length, asunto: 'StudentScope MJ: ' + sinTerminar.length + ' estudiantes inactivos sin terminar', texto } }];"
      },
      "id": "armar-aviso",
      "name": "Armar aviso",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "hay-inactivos",
              "leftValue": "={{ $json.cantidad }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "hay-alguno",
      "name": "¿Hay alguno?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        960,
        0
      ]
    },
    {
      "parameters": {
        "fromEmail": "={{ $env.AVISOS_REMITENTE }}",
        "toEmail": "={{ $env.AVISOS_DESTINO }}",
        "subject": "={{ $json.asunto }}",
        "emailFormat": "text",
        "text": "={{ $json.texto }}",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "enviar-correo",
      "name": "Enviar correo",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1200,
        -80
      ]
    }
  ],
  "connections": {
    "Cada día a las 8": {
      "main": [
        [
          {
            "node": "Iniciar sesión",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Iniciar sesión": {
      "main": [
        [
          {
            "node": "Inactivos",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Inactivos": {
      "main": [
        [
          {
            "node": "Armar aviso",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Armar aviso": {
      "main": [
        [
          {
            "node": "¿Hay alguno?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "¿Hay alguno?": {
      "main": [
        [
          {
            "node": "Enviar correo",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false
}
